          "mode": "raw",
          "raw": "{\n  \"contaOrigemId\": \"{{contaOrigemId}}\",\n  \"contaDestinoId\": \"{{contaDestinoId}}\",\n  \"valor\": 25.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Mesma operação na repetição\", function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"operacaoId\")); });"
            ]
          }
        }
      ],
      "response": []
    },
